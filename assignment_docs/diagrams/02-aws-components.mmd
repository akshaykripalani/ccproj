flowchart TB
    dashboard["Dashboard<br/>React / S3 + CloudFront<br/>Cognito sign-in"]
    api["API Gateway<br/>Secure API access"]
    app["App Lambda<br/>Live views / motor controls<br/>Users / report requests"]
    data["Data & reporting<br/>DynamoDB: live state<br/>S3: historical readings<br/>Athena + Glue: reports"]
    ec2["EC2 simulator<br/>Three simulated motors"]
    ing["Ingestion Lambda<br/>Validate telemetry"]
    queue["SQS queue<br/>Buffer / retry telemetry"]
    processor["Processor Lambda<br/>Store readings / detect faults"]
    notifications["Fault notifications<br/>DynamoDB outbox / scheduled Notifier Lambda / SNS email"]
    dashboard --> api
    api --> app
    app <--> data
    ec2 --> api
    api --> ing
    ing --> queue
    queue --> processor
    processor --> data
    data --> notifications
