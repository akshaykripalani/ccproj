    resolved["Resolved episode<br/>Keep alert history<br/>No recovery email"]
    request -->|"~5-second poll"| apply
    apply -->|"If no ack"| timeout
    healthy -->|"3 consecutive breaches"| active
    active -->|"3 consecutive healthy"| resolved
